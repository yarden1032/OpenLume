<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:OpenLume.App.Controls"
        x:Class="OpenLume.App.Views.MainWindow"
        x:CompileBindings="False"
        Title="OpenLume"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#090B0E">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="#1B212A" />
      <Setter Property="BorderBrush" Value="#343E4B" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="#DCE3EC" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#252D38" />
      <Setter Property="BorderBrush" Value="#536174" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#11161D" />
      <Setter Property="BorderBrush" Value="#6B7A90" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="Button.compact">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="#AEB8C6" />
    </Style>
    <Style Selector="Button.ghost:pointerover">
      <Setter Property="Background" Value="#202731" />
      <Setter Property="BorderBrush" Value="#303A47" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#4D7CFE" />
      <Setter Property="BorderBrush" Value="#6D95FF" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover">
      <Setter Property="Background" Value="#638CFF" />
      <Setter Property="BorderBrush" Value="#89A8FF" />
    </Style>
    <Style Selector="Button.accent:pressed">
      <Setter Property="Background" Value="#3D68DA" />
      <Setter Property="BorderBrush" Value="#557FEA" />
    </Style>
    <Style Selector="ToggleButton.workspace">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Foreground" Value="#9DA8B7" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ToggleButton.workspace:pointerover">
      <Setter Property="Background" Value="#1C222B" />
      <Setter Property="Foreground" Value="#E7ECF3" />
    </Style>
    <Style Selector="ToggleButton.workspace:checked">
      <Setter Property="Background" Value="#2A3140" />
      <Setter Property="BorderBrush" Value="#465267" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Expander.panel">
      <Setter Property="Background" Value="#151920" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBlock.section-label">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#798495" />
      <Setter Property="LetterSpacing" Value="1" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="64,*,36">
    <!-- Application bar -->
    <Border Grid.Row="0" Background="#12161C" BorderBrush="#272D36" BorderThickness="0,0,0,1" Padding="12,9">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid ColumnDefinitions="Auto,20,Auto,*,Auto,Auto,Auto" MinWidth="850">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="8" Background="#4D7CFE">
            <TextBlock Text="L" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="-2">
            <TextBlock Text="OpenLume" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="LOCAL PHOTO STUDIO" FontSize="9" Foreground="#6F7A8A" LetterSpacing="1.2" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
          <ToggleButton Classes="workspace" Content="Library"
                        Command="{Binding ReturnToLibraryCommand}"
                        IsChecked="{Binding IsLibraryPresentation, Mode=OneWay}" />
          <ToggleButton Classes="workspace" Content="Develop"
                        Command="{Binding ShowDevelopCommand}"
                        IsChecked="{Binding IsDevelopPresentation, Mode=OneWay}"
                        IsEnabled="{Binding SelectedPhoto}" />
        </StackPanel>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
          <Button Classes="compact" Content="Import folder" Click="ImportFolder_OnClick" ToolTip.Tip="Add a folder without moving the originals" />
          <Button Classes="compact" Content="Import preset" Click="ImportPreset_OnClick" IsEnabled="{Binding SelectedPhoto}" ToolTip.Tip="Apply an Adobe Lightroom XMP preset" />
          <Button Classes="accent compact" Content="Export" Click="Export_OnClick" IsEnabled="{Binding SelectedPhoto}" ToolTip.Tip="Export as JPEG, PNG, or TIFF with quality and size settings" />
        </StackPanel>
        <Button Grid.Column="5" Classes="ghost compact" Content="Relink" Click="Relink_OnClick" Margin="6,0,0,0"
                IsVisible="{Binding SelectedItem.IsMissing}" />
        <Border Grid.Column="6" Background="#14291F" CornerRadius="12" Padding="10,5" Margin="10,0,0,0"
                VerticalAlignment="Center">
          <TextBlock Text="LOCAL-FIRST" Foreground="#77DBA0" FontSize="10" FontWeight="Bold" />
        </Border>
      </Grid>
      </ScrollViewer>
    </Border>

    <!-- Library workspace -->
    <Grid Grid.Row="1" IsVisible="{Binding IsLibraryPresentation}" ColumnDefinitions="216,*,248">
      <Border Grid.Column="0" Background="#11151A" BorderBrush="#272D36" BorderThickness="0,0,1,0" Padding="14">
        <ScrollViewer>
          <StackPanel Spacing="16">
            <StackPanel Spacing="8">
              <TextBlock Classes="section-label" Text="CATALOG" />
              <Button HorizontalContentAlignment="Left" Command="{Binding ClearFiltersCommand}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="All photographs" />
                  <TextBlock Grid.Column="1" Text="{Binding TotalCount, StringFormat='{}{0:N0}'}" Foreground="#7B8593" />
                </Grid>
              </Button>
              <ToggleButton HorizontalContentAlignment="Stretch" IsChecked="{Binding MissingOnly, Mode=TwoWay}">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Missing originals" Foreground="#FFAD83" />
                  <TextBlock Grid.Column="1" Text="{Binding MissingCount}" Foreground="#FFAD83" />
                </Grid>
              </ToggleButton>
            </StackPanel>

            <StackPanel Spacing="7">
              <TextBlock Classes="section-label" Text="FOLDERS" />
              <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                       MaxHeight="180" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="2,4">
                      <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding PhotoCount}" Foreground="#6F7A8A" Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <StackPanel Spacing="7">
              <TextBlock Classes="section-label" Text="COLLECTIONS" />
              <ListBox ItemsSource="{Binding Collections}" SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                       MaxHeight="150" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="2,4">
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding PhotoCount}" Foreground="#6F7A8A" Margin="8,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto">
                <TextBox PlaceholderText="New collection" Text="{Binding NewCollectionName}" />
                <Button Grid.Column="1" Content="+" Command="{Binding CreateCollectionCommand}" Margin="6,0,0,0" />
              </Grid>
              <Button Content="Add selection to collection" Command="{Binding AddToCollectionCommand}" />
            </StackPanel>

            <StackPanel Spacing="7">
              <TextBlock Classes="section-label" Text="STACKS" />
              <ListBox ItemsSource="{Binding Stacks}" SelectedItem="{Binding SelectedStack, Mode=TwoWay}"
                       MaxHeight="120" Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Name}" Margin="2,4" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Stack selected photos" Command="{Binding CreateStackCommand}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="64,*,46" Background="#0B0E12">
        <Border Grid.Row="0" Background="#10141A" BorderBrush="#272D36" BorderThickness="0,0,0,1" Padding="16,10">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid ColumnDefinitions="300,Auto,Auto,Auto" MinWidth="560">
            <TextBox HorizontalAlignment="Stretch" PlaceholderText="Search photos, filenames, or paths"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0">
              <TextBlock Text="Rating" VerticalAlignment="Center" Foreground="#8C96A5" />
              <NumericUpDown Minimum="0" Maximum="5" Value="{Binding MinimumRating}" Width="54" />
            </StackPanel>
            <CheckBox Grid.Column="2" Content="Picks only" IsChecked="{Binding PicksOnly}" VerticalAlignment="Center" Margin="8,0" />
            <CheckBox Grid.Column="3" Content="Missing" IsChecked="{Binding MissingOnly}" VerticalAlignment="Center" />
          </Grid>
          </ScrollViewer>
        </Border>

        <Grid Grid.Row="1">
          <ListBox x:Name="LibraryGrid"
                   ItemsSource="{Binding LibraryItems}"
                   SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                   SelectionMode="Multiple"
                   SelectionChanged="LibraryList_OnSelectionChanged"
                   DoubleTapped="LibraryGrid_OnDoubleTapped"
                   Background="Transparent"
                   Padding="12">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Width="184" Height="174" Margin="5" Padding="7" Background="#151A21"
                        BorderBrush="#252C36" BorderThickness="1" CornerRadius="8">
                  <Grid RowDefinitions="*,Auto">
                    <Border Background="#080A0D" CornerRadius="5" ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                        <Border Background="#B0000000" CornerRadius="4" Padding="6,2"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6">
                          <TextBlock Text="{Binding Rating, StringFormat='★ {0}'}" Foreground="#F0C966" FontSize="11" />
                        </Border>
                        <Border Background="#CC612E28" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding IsMissing}">
                          <TextBlock Text="ORIGINAL MISSING" FontSize="10" FontWeight="Bold" />
                        </Border>
                      </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="2,7,2,0">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="12" />
                        <TextBlock Text="{Binding Dimensions}" Foreground="#6F7A8A" FontSize="10" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Extension}" Foreground="#596473" FontSize="10"
                                 VerticalAlignment="Bottom" />
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel IsVisible="{Binding !SelectedPhoto}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <TextBlock Text="Your photographs will live here" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Import a folder. OpenLume references your originals and never moves or modifies them."
                       Foreground="#758090" TextWrapping="Wrap" MaxWidth="440" TextAlignment="Center" />
            <Button Classes="accent" Content="Import a photo folder" Click="ImportFolder_OnClick" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="#10141A" BorderBrush="#272D36" BorderThickness="0,1,0,0" Padding="14,6">
          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Text="{Binding SelectedItems.Count, StringFormat='{}{0} selected'}" Foreground="#7B8593" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding PageSummary}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8C96A5" />
            <Button Grid.Column="2" Content="‹" Command="{Binding PreviousPageCommand}" Width="38" Margin="0,0,5,0" />
            <Button Grid.Column="3" Content="›" Command="{Binding NextPageCommand}" Width="38" />
          </Grid>
        </Border>
      </Grid>

      <Border Grid.Column="2" Background="#11151A" BorderBrush="#272D36" BorderThickness="1,0,0,0" Padding="16">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <TextBlock Classes="section-label" Text="SELECTED PHOTO" />
            <Border Height="176" Background="#080A0D" CornerRadius="7" ClipToBounds="True">
              <Image Source="{Binding Preview}" Stretch="Uniform" />
            </Border>
            <TextBlock Text="{Binding SelectedPhoto.FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding SelectedPhoto.OriginalPath}" FontSize="10" Foreground="#667181" TextWrapping="Wrap" />
            <Button Classes="accent" Content="Open in Develop" Command="{Binding ShowDevelopCommand}" ToolTip.Tip="Open the selected photo in the full editor" />
            <Grid ColumnDefinitions="*,*">
              <Button Content="Compare" Command="{Binding CompareCommand}" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="Survey" Command="{Binding SurveyCommand}" Margin="4,0,0,0" />
            </Grid>
            <Separator />
            <TextBlock Classes="section-label" Text="CULL" />
            <TextBlock Text="Rating" Foreground="#8C96A5" />
            <Slider Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Rating, Mode=TwoWay}" />
            <Grid ColumnDefinitions="*,*">
              <Button Content="Pick" Command="{Binding PickCommand}" Margin="0,0,4,0" />
              <Button Grid.Column="1" Content="Reject" Command="{Binding RejectCommand}" Margin="4,0,0,0" />
            </Grid>
            <Separator />
            <TextBlock Classes="section-label" Text="LOCAL AI" />
            <Button Content="Stage AI Develop proposal" Command="{Binding AnalyzeCommand}" />
            <TextBlock Text="{Binding SelectedPhoto.AiSummary}" TextWrapping="Wrap" Foreground="#919BAA" />
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- Develop workspace -->
    <Grid Grid.Row="1" IsVisible="{Binding IsDevelopPresentation}" ColumnDefinitions="*,336" RowDefinitions="*,118">
      <Grid Grid.Column="0" Grid.Row="0" Background="#07090C" RowDefinitions="48,*">
        <Border Grid.Row="0" Background="#10141A" BorderBrush="#272D36" BorderThickness="0,0,0,1" Padding="14,7">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="-2">
              <TextBlock Text="{Binding SelectedPhoto.FileName}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedPhoto.PixelWidth, StringFormat='{}{0:N0} px'}" FontSize="10" Foreground="#697483" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost compact" Content="Undo" Command="{Binding UndoCommand}" Margin="4,0" ToolTip.Tip="Undo the last edit (Ctrl+Z)" />
            <Button Grid.Column="2" Classes="ghost compact" Content="Redo" Command="{Binding RedoCommand}" Margin="4,0" ToolTip.Tip="Redo the last edit" />
            <ToggleButton Grid.Column="3" Content="Original" IsChecked="{Binding ShowBefore, Mode=TwoWay}" Margin="8,0,4,0" />
            <Button Grid.Column="4" Classes="ghost compact" Content="Reset" Command="{Binding ResetEditCommand}" Margin="4,0" ToolTip.Tip="Reset all global adjustments" />
          </Grid>
        </Border>
        <Grid Grid.Row="1">
          <Image Source="{Binding Preview}" Stretch="Uniform" Margin="30" />
          <controls:CropOverlayControl Margin="30"
                                       IsVisible="{Binding IsCropMode}"
                                       CropX="{Binding CropX, Mode=TwoWay}"
                                       CropY="{Binding CropY, Mode=TwoWay}"
                                       CropWidth="{Binding CropWidth, Mode=TwoWay}"
                                       CropHeight="{Binding CropHeight, Mode=TwoWay}"
                                       ImageAspectRatio="{Binding CropPreviewAspectRatio}"
                                       LockedNormalizedAspectRatio="{Binding CropLockedNormalizedAspectRatio}" />
          <Border Background="#AA11151A" CornerRadius="5" Padding="9,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16">
            <TextBlock Text="Space: pan · Ctrl+Z: undo · O: original" FontSize="10" Foreground="#AEB7C4" />
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Column="1" Grid.RowSpan="2" Background="#11151A" BorderBrush="#272D36" BorderThickness="1,0,0,0">
        <Grid RowDefinitions="132,62,*">
          <Border Margin="12,10,12,4" Background="#0A0D11" BorderBrush="#2A313B" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
            <Grid RowDefinitions="*,24">
              <controls:HistogramControl Histogram="{Binding Histogram}" Margin="8,7,8,2" />
              <Border Grid.Row="1" Background="#151A21" Padding="8,3">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="HISTOGRAM" FontSize="9" FontWeight="Bold" Foreground="#778293" LetterSpacing="1" />
                  <TextBlock Grid.Column="1" Text="RGB · LIVE" FontSize="9" Foreground="#79C99E" />
                </Grid>
              </Border>
            </Grid>
          </Border>

          <Grid Grid.Row="1" Margin="16,8" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="-2">
              <TextBlock Text="DEVELOP" FontSize="15" FontWeight="Bold" />
              <TextBlock Text="Nondestructive adjustments" FontSize="10" Foreground="#6F7A8A" />
            </StackPanel>
            <Border Grid.Column="1" Background="#1A3126" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
              <TextBlock Text="GLOBAL" FontSize="9" FontWeight="Bold" Foreground="#78D9A1" />
            </Border>
          </Grid>

          <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8" Margin="10,0,10,16">
              <Expander Classes="panel" Header="Light" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Exposure" /><TextBlock Grid.Column="1" Text="{Binding Exposure, StringFormat='{}{0:F2} EV'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-5" Maximum="5" TickFrequency="0.1" Value="{Binding Exposure, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Contrast" /><TextBlock Grid.Column="1" Text="{Binding Contrast, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Contrast, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Highlights" /><TextBlock Grid.Column="1" Text="{Binding Highlights, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Highlights, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Shadows" /><TextBlock Grid.Column="1" Text="{Binding Shadows, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Shadows, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Whites" /><TextBlock Grid.Column="1" Text="{Binding Whites, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Whites, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Blacks" /><TextBlock Grid.Column="1" Text="{Binding Blacks, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Blacks, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Tone Curve">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <controls:ToneCurveControl Height="142" Curve="{Binding CurrentToneCurve}" />
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="PARAMETRIC REGIONS" Classes="section-label" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost compact" Content="Reset" Command="{Binding ResetToneCurveCommand}" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Highlights" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveHighlights, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding ToneCurveHighlights, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lights" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveLights, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding ToneCurveLights, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Darks" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveDarks, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding ToneCurveDarks, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Shadows" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveShadows, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding ToneCurveShadows, Mode=TwoWay}" />
                  <Expander Header="Region splits" FontSize="11">
                    <StackPanel Spacing="6" Margin="0,6,0,0">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Shadow split" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveShadowSplit, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                      <Slider Minimum="5" Maximum="85" TickFrequency="1" Value="{Binding ToneCurveShadowSplit, Mode=TwoWay}" />
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Midtone split" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveMidtoneSplit, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                      <Slider Minimum="10" Maximum="90" TickFrequency="1" Value="{Binding ToneCurveMidtoneSplit, Mode=TwoWay}" />
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Highlight split" /><TextBlock Grid.Column="1" Text="{Binding ToneCurveHighlightSplit, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                      <Slider Minimum="15" Maximum="95" TickFrequency="1" Value="{Binding ToneCurveHighlightSplit, Mode=TwoWay}" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Color" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Temperature" /><TextBlock Grid.Column="1" Text="{Binding Temperature, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Temperature, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Tint" /><TextBlock Grid.Column="1" Text="{Binding Tint, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Tint, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Saturation" /><TextBlock Grid.Column="1" Text="{Binding Saturation, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Saturation, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vibrance" /><TextBlock Grid.Column="1" Text="{Binding Vibrance, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Vibrance, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Color Mixer (HSL)">
                <StackPanel Spacing="7" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="82,*,*,*" ColumnSpacing="5">
                    <TextBlock Text="COLOR" Classes="section-label" />
                    <TextBlock Grid.Column="1" Text="H" Classes="section-label" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="S" Classes="section-label" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="L" Classes="section-label" HorizontalAlignment="Center" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding ColorMixerChannels}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="82,*,*,*" ColumnSpacing="5" Margin="0,3">
                          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Swatch}" />
                            <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" />
                          </StackPanel>
                          <Slider Grid.Column="1" Minimum="-100" Maximum="100" TickFrequency="1"
                                  Value="{Binding Hue, Mode=TwoWay}" ToolTip.Tip="{Binding Hue, StringFormat='Hue {0:F0}'}" />
                          <Slider Grid.Column="2" Minimum="-100" Maximum="100" TickFrequency="1"
                                  Value="{Binding Saturation, Mode=TwoWay}" ToolTip.Tip="{Binding Saturation, StringFormat='Saturation {0:F0}'}" />
                          <Slider Grid.Column="3" Minimum="-100" Maximum="100" TickFrequency="1"
                                  Value="{Binding Luminance, Mode=TwoWay}" ToolTip.Tip="{Binding Luminance, StringFormat='Luminance {0:F0}'}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Drag a color row to refine hue, saturation, and luminance without affecting the rest of the image."
                             TextWrapping="Wrap" FontSize="10" Foreground="#778292" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Effects">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Texture" /><TextBlock Grid.Column="1" Text="{Binding Texture, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Texture, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Clarity" /><TextBlock Grid.Column="1" Text="{Binding Clarity, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Clarity, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Dehaze" /><TextBlock Grid.Column="1" Text="{Binding Dehaze, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Dehaze, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vignette" /><TextBlock Grid.Column="1" Text="{Binding Vignette, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding Vignette, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Grain" /><TextBlock Grid.Column="1" Text="{Binding Grain, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Grain, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Detail">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sharpening" /><TextBlock Grid.Column="1" Text="{Binding Sharpening, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding Sharpening, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Radius" /><TextBlock Grid.Column="1" Text="{Binding SharpeningRadius, StringFormat='{}{0:F1}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0.5" Maximum="3" TickFrequency="0.1" Value="{Binding SharpeningRadius, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Edge masking" /><TextBlock Grid.Column="1" Text="{Binding SharpeningMasking, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding SharpeningMasking, Mode=TwoWay}" ToolTip.Tip="Higher values protect smooth areas from sharpening" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Noise reduction" /><TextBlock Grid.Column="1" Text="{Binding NoiseReduction, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding NoiseReduction, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Color noise reduction" /><TextBlock Grid.Column="1" Text="{Binding ColorNoiseReduction, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding ColorNoiseReduction, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Optics">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="LENS CORRECTIONS" Classes="section-label" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="ghost compact" Content="Reset" Command="{Binding ResetOpticsCommand}" />
                  </Grid>
                  <TextBlock Text="Correct lens geometry, color fringing, and edge illumination before crop."
                             TextWrapping="Wrap" FontSize="10" Foreground="#778292" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Distortion" /><TextBlock Grid.Column="1" Text="{Binding LensDistortion, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding LensDistortion, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Chromatic aberration" /><TextBlock Grid.Column="1" Text="{Binding ChromaticAberration, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding ChromaticAberration, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lens vignette" /><TextBlock Grid.Column="1" Text="{Binding LensVignette, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-100" Maximum="100" TickFrequency="1" Value="{Binding LensVignette, Mode=TwoWay}" />
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Vignette midpoint" /><TextBlock Grid.Column="1" Text="{Binding LensVignetteMidpoint, StringFormat='{}{0:F0}'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="0" Maximum="100" TickFrequency="1" Value="{Binding LensVignetteMidpoint, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Geometry" IsExpanded="True">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <TextBlock Text="{Binding CropModeLabel}" TextWrapping="Wrap" FontSize="10" Foreground="#7F8A9A" />
                  <Button Content="Enter crop mode" Command="{Binding StartCropCommand}" IsVisible="{Binding !IsCropMode}" />
                  <StackPanel IsVisible="{Binding IsCropMode}" Spacing="8">
                    <Grid ColumnDefinitions="*,*">
                      <Button Classes="accent" Content="Apply crop" Command="{Binding ApplyCropCommand}" Margin="0,0,4,0" />
                      <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCropCommand}" Margin="4,0,0,0" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <TextBlock Text="Aspect" VerticalAlignment="Center" />
                      <ComboBox Grid.Column="1" ItemsSource="{Binding CropAspectOptions}" SelectedItem="{Binding SelectedCropAspect, Mode=TwoWay}" />
                    </Grid>
                    <UniformGrid Columns="4" Rows="1">
                      <Button Classes="compact" Content="↶ 90°" Command="{Binding RotateCropLeftCommand}" ToolTip.Tip="Rotate left" Margin="0,0,3,0" />
                      <Button Classes="compact" Content="↷ 90°" Command="{Binding RotateCropRightCommand}" ToolTip.Tip="Rotate right" Margin="3,0" />
                      <Button Classes="compact" Content="⇆" Command="{Binding FlipCropHorizontalCommand}" ToolTip.Tip="Flip horizontal" Margin="3,0" />
                      <Button Classes="compact" Content="⇅" Command="{Binding FlipCropVerticalCommand}" ToolTip.Tip="Flip vertical" Margin="3,0,0,0" />
                    </UniformGrid>
                    <TextBlock Text="{Binding CropOrientationSummary}" FontSize="10" Foreground="#8792A2" HorizontalAlignment="Center" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Straighten" /><TextBlock Grid.Column="1" Text="{Binding RotationDegrees, StringFormat='{}{0:F1}°'}" Foreground="#8792A2" /></Grid>
                  <Slider Minimum="-45" Maximum="45" TickFrequency="0.5" Value="{Binding RotationDegrees, Mode=TwoWay}" />
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="Versions and snapshots">
                <StackPanel Spacing="8" Margin="0,10,0,2">
                  <Grid ColumnDefinitions="*,*">
                    <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,4,0" />
                    <Button Grid.Column="1" Content="Redo" Command="{Binding RedoCommand}" Margin="4,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding EditRevisions}">
                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Sequence, StringFormat='Revision {0}'}" FontSize="11" Foreground="#7B8593" /></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox PlaceholderText="Snapshot name" Text="{Binding NewSnapshotName}" />
                    <Button Grid.Column="1" Content="Save" Command="{Binding CreateSnapshotCommand}" Margin="6,0,0,0" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding EditSnapshots}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Button Content="{Binding Name}" Command="{Binding $parent[Window].DataContext.RestoreSnapshotCommand}"
                              CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Expander>

              <Expander Classes="panel" Header="AI Develop Director" IsExpanded="True">
                <StackPanel Spacing="9" Margin="0,10,0,2">
                  <Border Background="#10251C" BorderBrush="#27533C" BorderThickness="1" CornerRadius="6" Padding="9,7">
                    <StackPanel Spacing="2">
                      <TextBlock Text="PARAMETERS ONLY · NO PIXEL GENERATION" FontSize="9" FontWeight="Bold" Foreground="#79D5A1" />
                      <TextBlock Text="Ollama proposes normal Develop settings. Nothing changes until you apply."
                                 TextWrapping="Wrap" FontSize="10" Foreground="#9EAEAA" />
                    </StackPanel>
                  </Border>
                  <Button Classes="accent" Content="Analyze &amp; stage proposal" Command="{Binding AnalyzeCommand}"
                          ToolTip.Tip="Ask local Ollama to choose nondestructive Develop parameters" />
                  <StackPanel IsVisible="{Binding HasPendingAiSuggestion}" Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding AiSuggestion.Intent}" TextWrapping="Wrap" FontWeight="SemiBold" />
                      <Border Grid.Column="1" Background="#242C39" CornerRadius="9" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding AiSuggestionConfidence}" FontSize="9" Foreground="#AFC1DE" />
                      </Border>
                    </Grid>
                    <TextBlock Text="{Binding SelectedPhoto.AiSummary}" TextWrapping="Wrap" FontSize="11" Foreground="#9BA6B5" />
                    <Grid ColumnDefinitions="*,*">
                      <Button Content="{Binding AiPreviewLabel}" Command="{Binding PreviewAiSuggestionCommand}" Margin="0,0,4,0" />
                      <Button Grid.Column="1" Classes="accent" Content="Apply" Command="{Binding ApplyAiSuggestionCommand}" Margin="4,0,0,0" />
                    </Grid>
                    <Button Classes="ghost compact" Content="Reject proposal" Command="{Binding RejectAiSuggestionCommand}" />
                    <TextBlock Classes="section-label" Text="WHY THESE CHANGES" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding AiParameterChanges}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="0,3" Spacing="1">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                              <TextBlock Text="{Binding Parameter}" FontSize="10" FontWeight="Bold" Foreground="#B9C7DA" />
                              <TextBlock Grid.Column="1" Text="{Binding ProposedValue}" FontSize="10" FontWeight="Bold" Foreground="#E3E9F2" />
                              <TextBlock Grid.Column="2" Text="{Binding Delta, StringFormat='  Δ {0}'}" FontSize="9" Foreground="#739BEF" />
                            </Grid>
                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="10" Foreground="#7F8B9B" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding AiSuggestionWarnings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10" Foreground="#E1B878" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <TextBlock IsVisible="{Binding !HasPendingAiSuggestion}" Text="Analyze to receive an explainable, reversible edit recipe."
                             TextWrapping="Wrap" FontSize="10" Foreground="#697483" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Column="0" Grid.Row="1" Background="#10141A" BorderBrush="#272D36" BorderThickness="0,1,0,0" Padding="10">
        <ListBox ItemsSource="{Binding LibraryItems}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Width="112" Height="94" Margin="3" Padding="4" Background="#171C23" CornerRadius="5">
                <Grid RowDefinitions="*,Auto">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  <TextBlock Grid.Row="1" Text="{Binding FileName}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="2,3,2,0" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </Grid>

    <!-- Compare workspace -->
    <Grid Grid.Row="1" IsVisible="{Binding IsComparePresentation}" Background="#080A0D" RowDefinitions="48,*">
      <Border Background="#10141A" Padding="14,7" BorderBrush="#272D36" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="COMPARE" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Back to Library" Command="{Binding ReturnToLibraryCommand}" />
        </Grid>
      </Border>
      <Grid Grid.Row="1" ColumnDefinitions="*,*">
        <Border BorderBrush="#272D36" BorderThickness="0,0,1,0"><Image Source="{Binding Preview}" Stretch="Uniform" Margin="24" /></Border>
        <Image Grid.Column="1" Source="{Binding SecondaryPreview}" Stretch="Uniform" Margin="24" />
      </Grid>
    </Grid>

    <!-- Survey workspace -->
    <Grid Grid.Row="1" IsVisible="{Binding IsSurveyPresentation}" Background="#0B0E12" RowDefinitions="48,*">
      <Border Background="#10141A" Padding="14,7" BorderBrush="#272D36" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="SURVEY" FontWeight="Bold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Back to Library" Command="{Binding ReturnToLibraryCommand}" />
        </Grid>
      </Border>
      <ScrollViewer Grid.Row="1" Margin="16">
        <ItemsControl ItemsSource="{Binding SelectedItems}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Width="300" Height="240" Background="#151A21" Margin="7" Padding="7" CornerRadius="8">
              <Grid RowDefinitions="*,Auto">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                <TextBlock Grid.Row="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="4" />
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#12161C" BorderBrush="#272D36" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11" Foreground="#8792A2" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding IndexedCount, StringFormat='{}{0:N0} indexed'}" IsVisible="{Binding IsIndexing}"
                   VerticalAlignment="Center" Foreground="#6F7A8A" Margin="8,0" FontSize="11" />
        <ProgressBar Grid.Column="2" Width="110" IsVisible="{Binding IsWorking}" IsIndeterminate="True" Margin="8,0" />
        <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsWorking}" Padding="8,3" />
      </Grid>
    </Border>
  </Grid>
</Window>
